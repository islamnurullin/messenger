# Python
__pycache__/
*.py[cod]
*.so
.Python
.venv/
venv/
env/
*.egg-info/
dist/
build/
# pytest создаёт здесь временные каталоги, если системный %TEMP% недоступен
# (так бывает под песочницей: tempfile молча откатывается к текущему каталогу).
pytest-of-*/
.pytest_cache/

# Django
*.log
db.sqlite3
db.sqlite3-journal
# media и staticfiles создаются относительно BASE_DIR (backend/), а не корня репо:
# якорь /media/ их не покрывал, и загруженные аватары попадали в git status.
media/
staticfiles/
.env
.env.*
!.env.example

# Node
node_modules/
.pnpm-store/
.npm/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
.svelte-kit/
build/
dist/
.output/

# Electron
desktop/release/
desktop/out/

# Flutter / Dart
.dart_tool/
.packages
.pub-cache/
.pub/
mobile/build/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
*.iml
.flutter-plugins

# IDE / OS
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Testing / coverage
.coverage
.coverage.*
htmlcov/
.pytest_cache/
coverage.xml
*.lcov

# Docker volumes (local dev data)
infra/volumes/

# Временные файлы скриптов и диагностики
.tmp/
*.bak-*
# Временные файлы PowerShell и редакторов в корне проекта
tmp[a-z0-9]*
*.tmp
~$*
