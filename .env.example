# === Django ===
DJANGO_SECRET_KEY=dev-insecure-change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_SETTINGS_MODULE=config.settings.dev

# === PostgreSQL ===
POSTGRES_DB=messenger
POSTGRES_USER=messenger
POSTGRES_PASSWORD=messenger
# Хост-порт 5433 (не 5432): 5432 на Windows часто занят нативной службой postgresql-x64-*.
POSTGRES_HOST_PORT=5433
# Для Django, запущенного на хосте (venv). Внутри Docker compose подменяет на postgres:5432.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
DATABASE_URL=postgresql://messenger:messenger@127.0.0.1:5433/messenger

# === Redis ===
# Внутри Docker-сети — redis:6379; на хосте Docker публикует его на 127.0.0.1:6379.
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# === Elasticsearch ===
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_ENABLED=false

# === Centrifugo ===
# hmac_secret_key — identifies our JWT (client tokens) and equals http_api.key
CENTRIFUGO_WS_URL=ws://127.0.0.1:8001/connection/websocket
CENTRIFUGO_HTTP_URL=http://127.0.0.1:8001
CENTRIFUGO_API_KEY=dev-centrifugo-api-key-change-me
CENTRIFUGO_TOKEN_HMAC_SECRET=dev-centrifugo-hmac-secret-change-me

# === JWT (DRF simplejwt) ===
JWT_SIGNING_KEY=dev-jwt-signing-key-change-me
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
